# Salin menjadi .env untuk lokal. Di Vercel isi lewat Project > Settings > Environment Variables.
# Contoh Supabase/Neon (gunakan connection string pooler milik kamu sendiri):
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# false hanya untuk PostgreSQL lokal tanpa SSL
DB_SSL=true
PORT=3000
